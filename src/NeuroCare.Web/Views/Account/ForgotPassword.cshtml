@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Esqueci minha senha"; }
<div class="row justify-content-center"><div class="col-md-6 col-lg-4">
    <h1 class="h4 text-center mb-3">Esqueci minha senha</h1>
    <div class="card"><div class="card-body p-4">
        <form asp-action="ForgotPassword" method="post" novalidate>
            <p class="text-muted small">Informe seu e-mail. Se ele estiver cadastrado, enviaremos um link para redefinir a senha.</p>
            <div class="mb-3"><label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" class="form-control" autocomplete="username" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <button class="btn btn-primary w-100" type="submit">Enviar link</button>
            <a class="d-block text-center mt-3 small" asp-action="Login">Voltar ao login</a>
        </form>
    </div></div>
</div></div>

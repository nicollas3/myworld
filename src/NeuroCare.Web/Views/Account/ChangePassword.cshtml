@model ChangePasswordViewModel
@{ ViewData["Title"] = "Alterar senha"; }
<h1 class="h4 mb-3">Alterar senha</h1>
<form asp-action="ChangePassword" method="post" class="col-md-6 col-lg-4" novalidate>
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
    <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><div class="input-group"><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><button type="button" class="btn btn-outline-secondary" data-toggle-password="#CurrentPassword" aria-label="Mostrar senha" aria-pressed="false" title="Mostrar senha">🩺🙈</button></div></div>
    <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><div class="input-group"><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><button type="button" class="btn btn-outline-secondary" data-toggle-password="#NewPassword" aria-label="Mostrar senha" aria-pressed="false" title="Mostrar senha">🩺🙈</button></div><div class="form-text">Mínimo de 10 caracteres, com maiúscula, minúscula, número e símbolo.</div></div>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><div class="input-group"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><button type="button" class="btn btn-outline-secondary" data-toggle-password="#ConfirmPassword" aria-label="Mostrar senha" aria-pressed="false" title="Mostrar senha">🩺🙈</button></div></div>
    <button class="btn btn-primary" type="submit">Salvar</button>
</form>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}

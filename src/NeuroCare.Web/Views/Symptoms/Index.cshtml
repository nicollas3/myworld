@model IReadOnlyList<SymptomListItemDto>
@using System.Text.Json
@{
    ViewData["Title"] = "Sintomas";
    var h = (PatientHeaderDto)ViewData["Header"]!;
    var isPatient = User.IsInRole(Roles.Patient);
    var days = (int)(ViewData["Days"] ?? 90);
    var byDay = Model.GroupBy(s => s.OccurredAtLocal.Date).OrderBy(g => g.Key).ToList();
    var labels = byDay.Select(g => g.Key.ToString("dd/MM")).ToArray();
    var values = byDay.Select(g => g.Max(s => s.Intensity)).ToArray();
    object? route = isPatient ? null : new { patientId = h.Id };
}
<partial name="_ClinicalHeader" />
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">Diário de sintomas (últimos @days dias)</h2>
    <a class="btn btn-primary" href="@Url.Action("Create", "Symptoms", route)">Registrar sintoma</a>
</div>

@if (Model.Count > 0)
{
    <div class="card mb-3"><div class="card-body">
        <div class="small text-muted mb-2">Maior intensidade registrada por dia (0 a 10)</div>
        <canvas data-chart="line" data-max="10" data-label="Intensidade"
                data-labels="@JsonSerializer.Serialize(labels)" data-values="@JsonSerializer.Serialize(values)"></canvas>
    </div></div>
}

<div class="card"><div class="table-responsive">
<table class="table mb-0 align-middle">
    <thead><tr><th>Data</th><th>Sintoma</th><th>Intensidade</th><th>Observações</th><th>Registrado por</th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr><td>@s.OccurredAtLocal.ToString("dd/MM/yyyy HH:mm")</td><td>@s.Type.Label()</td><td>@s.Intensity/10</td><td class="text-break">@s.Notes</td><td>@(s.RecordedByPatient ? "Paciente" : "Equipe")</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-4">Nenhum sintoma registrado no período.</td></tr> }
    </tbody>
</table></div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

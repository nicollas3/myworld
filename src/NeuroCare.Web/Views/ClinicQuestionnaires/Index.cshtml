@model IReadOnlyList<ClinicQuestionnaireListItemDto>
@{ ViewData["Title"] = "Questionários da clínica"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-1">Questionários da clínica</h1><p class="text-muted mb-0">Instrumentos configuráveis desta organização.</p></div>
    <a asp-action="Create" class="btn btn-primary">Novo questionário</a>
</div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Título</th><th>Chave</th><th>Perguntas</th><th>Aplicação</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td><td><code>@item.Key</code></td><td>@item.ItemCount</td>
            <td>@(item.ClinicianOnly ? "Profissional" : "Médico/paciente")</td>
            <td><span class="badge @(item.Active ? "text-bg-success" : "text-bg-secondary")">@(item.Active ? "Ativo" : "Inativo")</span></td>
            <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-muted text-center py-4">Nenhum questionário customizado.</td></tr> }
    </tbody>
</table></div></div>

@model ClinicalNoteDetailsDto
@{ ViewData["Title"] = "Evolução clínica"; }
<partial name="_ClinicalHeader" />
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">Evolução de @Model.OccurredAtLocal.ToString("dd/MM/yyyy HH:mm")</h2>
        <div class="text-muted small">@Model.DoctorName &middot;
            <span class="badge @(Model.Status == NoteStatus.Signed ? "text-bg-success" : "text-bg-secondary")">@Model.Status.Label()</span>
            @if (Model.SignedAtLocal.HasValue) { <span> em @Model.SignedAtLocal.Value.ToString("dd/MM/yyyy HH:mm")</span> }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-patientId="@Model.PatientId">Voltar</a>
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
            <form asp-action="Sign" asp-route-id="@Model.Id" method="post"><button class="btn btn-success" type="submit">Assinar</button></form>
        }
    </div>
</div>
@if (Model.CanEdit)
{
    <div class="alert alert-warning small">Ao assinar, a evolução deixa de poder ser editada. Correções depois disso são feitas por adendo.</div>
}

@foreach (var (title, text) in new[] { ("S – Subjetivo", Model.Subjective), ("O – Objetivo", Model.Objective), ("A – Avaliação", Model.Assessment), ("P – Plano", Model.Plan) })
{
    <div class="card mb-3"><div class="card-header bg-white fw-semibold">@title</div>
        <div class="card-body pre-wrap text-break">@(string.IsNullOrWhiteSpace(text) ? "—" : text)</div></div>
}

<h3 class="h6 mt-4">Adendos</h3>
@foreach (var a in Model.Addenda)
{
    <div class="card mb-2"><div class="card-body">
        <div class="small text-muted">@a.CreatedAtLocal.ToString("dd/MM/yyyy HH:mm") &middot; @a.DoctorName</div>
        <div class="pre-wrap text-break">@a.Text</div>
    </div></div>
}
@if (Model.Addenda.Count == 0) { <p class="text-muted small">Nenhum adendo.</p> }

@if (Model.Status == NoteStatus.Signed)
{
    <form asp-action="Addendum" asp-route-id="@Model.Id" method="post" class="mt-3">
        <label class="form-label" for="Text">Novo adendo</label>
        <textarea id="Text" name="Text" rows="3" maxlength="2000" class="form-control"></textarea>
        <button class="btn btn-outline-primary mt-2" type="submit">Registrar adendo</button>
    </form>
}

@model SaveClinicalNoteDto
@{ ViewData["Title"] = "Editar evolução"; }
<partial name="_ClinicalHeader" />
<h2 class="h5 mb-3">Editar rascunho</h2>
<form asp-action="Edit" asp-route-id="@ViewData["NoteId"]" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@ViewData["NoteId"]">Cancelar</a></div>
</form>

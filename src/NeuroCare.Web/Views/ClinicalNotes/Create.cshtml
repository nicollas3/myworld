@model SaveClinicalNoteDto
@{ ViewData["Title"] = "Nova evolução"; }
<partial name="_ClinicalHeader" />
<h2 class="h5 mb-3">Nova evolução</h2>
<form asp-action="Create" asp-route-patientId="@ViewData["PatientId"]" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar rascunho</button><a class="btn btn-outline-secondary" asp-action="Index" asp-route-patientId="@ViewData["PatientId"]">Cancelar</a></div>
</form>

@model IReadOnlyList<ClinicalNoteListItemDto>
@{
    ViewData["Title"] = "Evolução clínica";
    var h = (PatientHeaderDto)ViewData["Header"]!;
}
<partial name="_ClinicalHeader" />
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">Evoluções (SOAP)</h2>
    <a class="btn btn-primary" asp-action="Create" asp-route-patientId="@h.Id">Nova evolução</a>
</div>
<div class="list-group">
@foreach (var n in Model)
{
    <a class="list-group-item list-group-item-action" asp-action="Details" asp-route-id="@n.Id">
        <div class="d-flex justify-content-between align-items-center">
            <strong>@n.OccurredAtLocal.ToString("dd/MM/yyyy HH:mm")</strong>
            <span class="badge @(n.Status == NoteStatus.Signed ? "text-bg-success" : "text-bg-secondary")">@n.Status.Label()</span>
        </div>
        <div class="small text-muted">@n.DoctorName</div>
        <div class="text-break">@n.Preview</div>
    </a>
}
@if (Model.Count == 0) { <div class="list-group-item text-muted">Nenhuma evolução registrada.</div> }
</div>

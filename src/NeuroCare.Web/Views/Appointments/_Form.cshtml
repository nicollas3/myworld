@model SaveAppointmentDto
@{
    var patients = (SelectList)ViewData["Patients"]!;
    var doctors = (SelectList)ViewData["Doctors"]!;
}
<div class="row g-3">
    <div class="col-md-6"><label asp-for="PatientId" class="form-label">Paciente</label><select asp-for="PatientId" asp-items="patients" class="form-select"><option value="">— Selecione —</option></select><span asp-validation-for="PatientId" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="DoctorId" class="form-label">Profissional</label><select asp-for="DoctorId" asp-items="doctors" class="form-select"><option value="">— Selecione —</option></select><span asp-validation-for="DoctorId" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="StartsAtLocal" class="form-label">Data e horário</label><input asp-for="StartsAtLocal" type="datetime-local" class="form-control" /><span asp-validation-for="StartsAtLocal" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="DurationMinutes" class="form-label">Duração (min)</label><input asp-for="DurationMinutes" type="number" min="5" max="240" class="form-control" /><span asp-validation-for="DurationMinutes" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Type" class="form-label">Tipo</label><select asp-for="Type" asp-items="EnumText.TypeItems()" class="form-select"></select></div>
    <div class="col-12"><label asp-for="Notes" class="form-label">Observações</label><textarea asp-for="Notes" rows="3" class="form-control"></textarea></div>
</div>

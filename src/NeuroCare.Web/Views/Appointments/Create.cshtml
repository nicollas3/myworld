@model SaveAppointmentDto
@{ ViewData["Title"] = "Agendar consulta"; }
<h1 class="h3 mb-3">Agendar consulta</h1>
<form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Agendar</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>

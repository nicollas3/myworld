@model IReadOnlyList<OrganizationSummaryDto>
@{ ViewData["Title"] = "Organizações"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Organizações</h1>
    <a class="btn btn-primary" asp-action="Create">Nova organização</a>
</div>
<div class="card"><div class="table-responsive">
<table class="table mb-0 align-middle">
    <thead><tr><th>Nome</th><th>Razão social</th><th>Documento</th><th>Criada em</th><th>Situação</th><th></th></tr></thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr>
            <td>@o.Name</td><td>@o.LegalName</td><td>@o.DocumentNumber</td><td>@o.CreatedAt.ToString("dd/MM/yyyy")</td>
            <td><span class="badge @(o.Active ? "text-bg-success" : "text-bg-secondary")">@(o.Active ? "Ativa" : "Inativa")</span></td>
            <td class="text-end">
                <form asp-action="SetActive" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@o.Id" />
                    <input type="hidden" name="active" value="@(o.Active ? "false" : "true")" />
                    <button class="btn btn-sm @(o.Active ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(o.Active ? "Desativar" : "Reativar")</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-muted text-center py-4">Nenhuma organização.</td></tr> }
    </tbody>
</table></div></div>

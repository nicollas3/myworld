@model IReadOnlyList<SeizureListItemDto>
@using System.Text.Json
@{
    ViewData["Title"] = "Crises";
    var h = (PatientHeaderDto)ViewData["Header"]!;
    var isPatient = User.IsInRole(Roles.Patient);
    var days = (int)(ViewData["Days"] ?? 90);
    var byMonth = Model.GroupBy(s => new { s.OccurredAtLocal.Year, s.OccurredAtLocal.Month })
        .OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month).ToList();
    var labels = byMonth.Select(g => $"{g.Key.Month:00}/{g.Key.Year}").ToArray();
    var values = byMonth.Select(g => g.Count()).ToArray();
    object? route = isPatient ? null : new { patientId = h.Id };
}
<partial name="_ClinicalHeader" />
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">Diário de crises (últimos @days dias)</h2>
    <a class="btn btn-primary" href="@Url.Action("Create", "Seizures", route)">Registrar crise</a>
</div>
<div class="alert alert-warning small">Em caso de emergência, ligue <strong>192 (SAMU)</strong>. Este registro é um diário e não substitui atendimento médico.</div>

@if (Model.Count > 0)
{
    <div class="card mb-3"><div class="card-body">
        <div class="small text-muted mb-2">Crises por mês</div>
        <canvas data-chart="bar" data-label="Crises"
                data-labels="@JsonSerializer.Serialize(labels)" data-values="@JsonSerializer.Serialize(values)"></canvas>
    </div></div>
}

<div class="card"><div class="table-responsive">
<table class="table mb-0 align-middle">
    <thead><tr><th>Data</th><th>Tipo</th><th>Duração</th><th>Perda de consciência</th><th>Gatilho</th><th>Observações</th><th>Registrado por</th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.OccurredAtLocal.ToString("dd/MM/yyyy HH:mm")</td><td>@s.Type.Label()</td>
            <td>@(s.DurationSeconds >= 60 ? $"{s.DurationSeconds / 60} min {s.DurationSeconds % 60} s" : $"{s.DurationSeconds} s")</td>
            <td>@(s.LossOfConsciousness ? "Sim" : "Não")</td><td class="text-break">@s.Trigger</td><td class="text-break">@s.Notes</td>
            <td>@(s.RecordedByPatient ? "Paciente" : "Equipe")</td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-muted text-center py-4">Nenhuma crise registrada no período.</td></tr> }
    </tbody>
</table></div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

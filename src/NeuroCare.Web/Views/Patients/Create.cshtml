@model CreatePatientDto
@{ ViewData["Title"] = "Novo paciente"; }
<h1 class="h3 mb-3">Novo paciente</h1>
<form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <div class="mb-3 col-md-4"><label asp-for="Cpf" class="form-label">CPF</label><input asp-for="Cpf" class="form-control" inputmode="numeric" placeholder="000.000.000-00" /><span asp-validation-for="Cpf" class="text-danger small"></span></div>
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>

@model SaveFallDto
@{ ViewData["Title"] = "Registrar queda"; }
<partial name="_ClinicalHeader" />
<h2 class="h5 mb-3">Registrar queda</h2>
<div class="alert alert-warning small">Em caso de lesão ou emergência, ligue <strong>192 (SAMU)</strong>.</div>
<form asp-action="Create" asp-route-patientId="@ViewData["PatientId"]" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="OccurredAtLocal" class="form-label">Quando</label><input asp-for="OccurredAtLocal" type="datetime-local" class="form-control" /><span asp-validation-for="OccurredAtLocal" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Circumstance" class="form-label">Situação</label><select asp-for="Circumstance" asp-items="EnumText.FallCircumstanceItems()" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="Location" class="form-label">Local (opcional)</label><input asp-for="Location" class="form-control" placeholder="ex.: sala, quintal" /></div>
        <div class="col-md-6"><div class="form-check"><input asp-for="Injury" class="form-check-input" /><label asp-for="Injury" class="form-check-label">Houve lesão</label></div></div>
        <div class="col-md-6"><div class="form-check"><input asp-for="NeededMedicalCare" class="form-check-input" /><label asp-for="NeededMedicalCare" class="form-check-label">Precisou de atendimento médico</label></div></div>
        <div class="col-12"><label asp-for="Notes" class="form-label">Observações</label><textarea asp-for="Notes" rows="3" class="form-control"></textarea></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar</button><a class="btn btn-outline-secondary" asp-action="Index" asp-route-patientId="@ViewData["PatientId"]">Cancelar</a></div>
</form>

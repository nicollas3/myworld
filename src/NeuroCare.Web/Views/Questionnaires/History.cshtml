@model IReadOnlyList<QuestionnaireResponseListItemDto>
@using System.Text.Json
@{
    ViewData["Title"] = "Histórico";
    var isDoctor = User.IsInRole(Roles.Doctor);
    var asc = Model.OrderBy(r => r.AnsweredAtLocal).ToList();
    var labels = asc.Select(r => r.AnsweredAtLocal.ToString("dd/MM/yy")).ToArray();
    var values = asc.Select(r => r.TotalScore).ToArray();
    var max = Model.Count > 0 ? Model[0].MaxScore : 0;
    var title = Model.Count > 0 ? Model[0].Title : (ViewData["Key"]?.ToString() ?? "");
}
<partial name="_ClinicalHeader" />
<h2 class="h5">Histórico: @title</h2>
@if (Model.Count > 1)
{
    <div class="card mb-3"><div class="card-body">
        <div class="small text-muted mb-2">Pontuação ao longo do tempo (máximo @max)</div>
        <canvas data-chart="line" data-max="@max" data-label="Pontuação"
                data-labels="@JsonSerializer.Serialize(labels)" data-values="@JsonSerializer.Serialize(values)"></canvas>
    </div></div>
}
<div class="card"><div class="table-responsive">
<table class="table mb-0 align-middle">
    <thead><tr><th>Data</th><th>Pontuação</th><th>Faixa</th><th>Registrado por</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.AnsweredAtLocal.ToString("dd/MM/yyyy HH:mm")</td><td>@r.TotalScore / @r.MaxScore</td>
            <td>@r.BandLabel @if (isDoctor && r.SafetyFlag) { <span class="badge text-bg-danger">atenção</span> }</td>
            <td>@(r.RecordedByPatient ? "Paciente" : "Equipe")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Result" asp-route-id="@r.Id">Abrir</a></td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-4">Nenhuma resposta no período.</td></tr> }
    </tbody>
</table></div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

@model QuestionnairesIndexViewModel
@{
    ViewData["Title"] = "Questionários";
    var isDoctor = User.IsInRole(Roles.Doctor);
    var isPatient = User.IsInRole(Roles.Patient);
    var pid = ViewData["PatientId"];
}
<partial name="_ClinicalHeader" />
<div class="alert alert-info small">@QuestionnaireCatalog.DisclaimerText</div>
<div class="row g-3">
    <div class="col-lg-6">
        <h2 class="h5">Instrumentos disponíveis</h2>
        @foreach (var q in Model.Available)
        {
            <div class="card mb-2"><div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <strong>@q.Title</strong>
                        @if (q.ClinicianOnly) { <span class="badge text-bg-light">aplicado pelo profissional</span> }
                        <div class="small text-muted">@q.Description</div>
                    </div>
                    <div class="d-flex gap-1">
                        <a class="btn btn-sm btn-primary" asp-action="Fill" asp-route-key="@q.Key" asp-route-patientId="@pid">Aplicar</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="History" asp-route-key="@q.Key" asp-route-patientId="@pid">Histórico</a>
                    </div>
                </div>
            </div></div>
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h5">Respostas recentes</h2>
        <div class="list-group">
        @foreach (var r in Model.Recent)
        {
            <a class="list-group-item list-group-item-action" asp-action="Result" asp-route-id="@r.Id">
                <div class="d-flex justify-content-between">
                    <strong>@r.Title</strong>
                    <span>@r.TotalScore / @r.MaxScore</span>
                </div>
                <div class="small text-muted">@r.AnsweredAtLocal.ToString("dd/MM/yyyy HH:mm") &middot; @r.BandLabel
                    @if (isDoctor && r.SafetyFlag) { <span class="badge text-bg-danger ms-1">atenção: item de segurança</span> }
                </div>
            </a>
        }
        @if (Model.Recent.Count == 0) { <div class="list-group-item text-muted">Nenhuma resposta ainda.</div> }
        </div>
    </div>
</div>
